{
  "name": "deutsch-journey",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "scripts": {
    "dev": "next dev -p 3008",
    "build": "next build",
    "start": "next start",
    "production:env": "node --experimental-strip-types scripts/prepare-production-env.ts",
    "lint": "eslint .",
    "format": "prettier --write src scripts tests docs README.md *.ts *.mjs package.json components.json",
    "format:check": "prettier --check src scripts tests docs README.md *.ts *.mjs package.json components.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "content:audit": "node --experimental-strip-types scripts/content/audit.ts",
    "content:validate": "node --experimental-strip-types scripts/content/cli.ts validate",
    "content:qa-report": "node --experimental-strip-types scripts/content/cli.ts qa-report",
    "content:audio-check": "node --experimental-strip-types scripts/content/cli.ts audio-manifest",
    "content:test": "vitest run tests/unit/content-pipeline.test.ts tests/unit/content-repository.test.ts tests/unit/content-resources.test.ts",
    "content:promote": "node --experimental-strip-types scripts/content/promote.ts",
    "content:fetch-zum": "node --experimental-strip-types scripts/content/fetch-zum.ts",
    "content:check-links": "node --experimental-strip-types scripts/content/check-resource-links.ts",
    "exams:validate": "node --experimental-strip-types scripts/exams/validate.ts",
    "exams:import": "node --experimental-strip-types scripts/exams/import.ts",
    "exams:promote": "node --experimental-strip-types scripts/exams/promote.ts",
    "exams:test": "vitest run --maxWorkers=2 tests/unit/exams.test.ts tests/unit/exam-repository.test.ts"
  },
  "dependencies": {
    "@fontsource-variable/nunito-sans": "5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "5.3.0",
    "@fontsource/skranji": "5.3.0",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@js-temporal/polyfill": "0.5.1",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "1.2.0",
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.3",
    "google-auth-library": "11.2.0",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.8",
    "lucide-react": "1.51.0",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0",
    "three": "^0.180.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@electric-sql/pglite": "0.5.9",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "dotenv": "18.0.5",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
