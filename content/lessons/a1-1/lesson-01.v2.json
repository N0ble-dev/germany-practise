  "grammar": [
    {
      "id": "g-present",
      "title": {
        "de": "ich, du und Sie",
        "en": "Introducing yourself with ich, du and Sie",
        "ar": "التعريف بالنفس باستخدام ich وdu وSie"
      },
      "explanation": {
        "de": "Ich heiße … Du heißt … Sie heißen … Mit Sie sprechen wir eine Person höflich an.",
        "en": "Use ich for yourself, du for an informal partner, and Sie for a formal partner. The verb form changes with the subject.",
        "ar": "نستخدم ich للحديث عن أنفسنا، وdu لمخاطبة شخص بصورة غير رسمية، وSie للمخاطبة الرسمية. يتغير تصريف الفعل بحسب الفاعل."
      },
      "examples": ["Ich heiße Lea.", "Wie heißt du?", "Wie heißen Sie?"]
    },
    {
      "id": "g-name-question",
      "title": {
        "de": "Nach dem Namen fragen",
        "en": "Ask a name: informal and formal",
        "ar": "السؤال عن الاسم: المخاطبة الرسمية وغير الرسمية"
      },
      "explanation": {
        "de": "Wie heißt du? ist informell. Wie heißen Sie? ist höflich. Sie schreiben wir in der höflichen Anrede groß.",
        "en": "Use Wie heißt du? informally, or Wie heißen Sie? formally. Formal Sie starts with a capital letter. These are draft teaching explanations adapted around ZUM's introductory patterns.",
        "ar": "نستخدم Wie heißt du? في المخاطبة غير الرسمية، وWie heißen Sie? في المخاطبة الرسمية. يبدأ ضمير المخاطبة الرسمي Sie بحرف كبير."
      },
      "examples": [
        "Wie heißt du?",
        "Wie heißen Sie?",
        "Woher kommst du?",
        "Woher kommen Sie?"
      ]
    },
    {
      "id": "g-pronouns",
      "title": {
        "de": "Personalpronomen im Nominativ",
        "en": "Subject pronouns",
        "ar": "ضمائر الفاعل"
      },
      "explanation": {
        "de": "ich, du, er, es, sie, wir, ihr, sie und Sie sind Personalpronomen im Nominativ. sie kann eine Frau oder mehrere Personen meinen; Sie ist die höfliche Anrede.",
        "en": "Subject forms include ich, du, er, es, sie, wir, ihr and Sie. The lower-case sie can mean she or they; capitalized Sie is formal you. The pronoun list comes from ZUM; this explanatory text and translations are new drafts.",
        "ar": "من ضمائر الفاعل: ich وdu وer وes وsie وwir وihr وSie. قد تعني sie هي أو هم، أما Sie بحرف كبير فتستخدم في المخاطبة الرسمية."
      },
      "examples": ["ich", "du", "er", "es", "sie", "wir", "ihr", "Sie"]
    },
    {
      "id": "g-statements",
      "title": {
        "de": "Kurze Aussagen",
        "en": "Simple statements",
        "ar": "جمل خبرية قصيرة"
      },
      "explanation": {
        "de": "In diesen Beispielen steht das konjugierte Verb nach dem Subjekt. Achten Sie auf das Verb und lesen Sie den Satz laut.",
        "en": "In these simple subject-first statements, the conjugated verb follows the subject. Notice the verb and say each sentence out loud. Example sentences are selected from ZUM; the teaching explanation and translations are drafts.",
        "ar": "في هذه الأمثلة التي تبدأ بالفاعل يأتي الفعل المصرف بعده. انتبه إلى الفعل واقرأ كل جملة بصوت مسموع."
      },
      "examples": [
        "Ich wohne in Berlin.",
        "Er kommt aus Syrien.",
        "Ich gehe nach Hause."
      ]
    }
  ],
  "dialogues": [
    {
      "id": "d-school",
      "context": {
        "de": "In der Sprachschule",
        "en": "At the language school",
        "ar": "في مدرسة اللغات"
      },
      "lines": [
        {
          "id": "line-1",
          "speaker": "A",
          "text": {
            "de": "Guten Tag! Ich heiße Nabil. Wie heißen Sie?",
            "en": "Hello! My name is Nabil. What is your name?",
            "ar": "مرحبًا! اسمي نبيل. ما اسم حضرتك؟"
          },
          "audioKey": null
        },
        {
          "id": "line-2",
          "speaker": "B",
          "text": {
            "de": "Ich heiße Anna. Freut mich.",
            "en": "My name is Anna. Nice to meet you.",
            "ar": "اسمي آنا. تشرفت بمعرفتك."
          },
          "audioKey": null
        },
        {
          "id": "line-3",
          "speaker": "A",
          "text": {
            "de": "Freut mich auch. Woher kommen Sie?",
            "en": "Nice to meet you too. Where are you from?",
            "ar": "وأنا أيضًا تشرفت بمعرفتك. من أين حضرتك؟"
          },
          "audioKey": null
        },
        {
          "id": "line-4",
          "speaker": "B",
          "text": {
            "de": "Ich komme aus Deutschland. Und Sie?",
            "en": "I'm from Germany. And you?",
            "ar": "أنا من ألمانيا. وحضرتك؟"
          },
          "audioKey": null
        },
        {
          "id": "line-5",
          "speaker": "A",
          "text": {
            "de": "Ich komme aus Ägypten.",
            "en": "I'm from Egypt.",
            "ar": "أنا من مصر."
          },
          "audioKey": null
        },
        {
          "id": "line-6",
          "speaker": "B",
          "text": {
            "de": "Und wo wohnen Sie?",
            "en": "And where do you live?",
            "ar": "وأين تسكن حضرتك؟"
          },
          "audioKey": null
        }
      ]
    }
  ],
