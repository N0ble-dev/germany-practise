# Local study works without these. Server-only credentials; do not use NEXT_PUBLIC_.
DATABASE_URL=
# Direct connection for migrations (the hostname has no -pooler suffix).
DATABASE_URL_UNPOOLED=
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Generate a random secret of at least 32 characters for signed session cookies.
NEON_AUTH_COOKIE_SECRET=
APP_URL=http://localhost:3008
# Production: https://germany-practise.vercel.app (see docs/production-auth.md).
# Optional direct Google Calendar connection. See docs/study-calendar.md.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Generate 32 random bytes, encoded as base64. Keep this key stable to read saved credentials.
CALENDAR_TOKEN_ENCRYPTION_KEY=
# Private content studio: verified Google emails, comma-separated, per permission.
CONTENT_AUTHOR_EMAILS=
CONTENT_LANGUAGE_EMAILS=
CONTENT_PEDAGOGY_EMAILS=
CONTENT_ARABIC_EMAILS=
CONTENT_RIGHTS_EMAILS=
CONTENT_AUDIO_EMAILS=
CONTENT_PUBLISHER_EMAILS=
# HTTPS public object-storage prefix containing immutable, versioned PCM WAV files.
CONTENT_AUDIO_BASE_URL=
# Publication workflow uses separate scoped credentials, never Vercel client env vars:
# CONTENT_REVIEW_DATABASE_URL, CONTENT_PUBLICATION_DATABASE_URL, CONTENT_PUBLISHER_ID.
